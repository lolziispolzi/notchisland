<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Needed under the hardened runtime to script Music and Spotify. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Needed under the hardened runtime for local weather. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Needed under the hardened runtime to read and add calendar events. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- Lets macOS 10.15 and 11 load the bundled Swift Concurrency library when the app
	     is signed with the local certificate, which has no Apple team ID. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
